import (
    ./.Io
)
literal NANO_PER_SEC: u64 = 10 ** 9
literal MILLI_PER_SEC: u64 = 10 ** 3
literal NANO_PER_MILLI: u64 = 10 ** 6

extern "C" __clib_Duration_now(duration: &Duration)
extern "C" __clib_delay_sec(sec: c_int)

DelaySec(sec: c_int) {
    __clib_delay_sec(sec)
}

struct Instance {
    mut time: Duration
}
use Instance {

    Now(): Instance {
        mut time = Duration{sec: 0, nano: 0}
        __clib_Duration_now(&time)
        Instance{time}
    }

    Reset(&this) {
        mut time = Duration{sec: 0, nano: 0}
        __clib_Duration_now(&time)
        this.time = time
    }

    Elapsed(this): Duration {
        now := Instance.Now()
        now.time.Sub(this.time)
    }
}

struct Duration {
    sec: u64
    nano: u32
}
use Duration {

    AsMillis(@this): u64 {
        seconds := this.sec * MILLI_PER_SEC
        nanoSeconds := this.nano as u64 / NANO_PER_MILLI / 10 as u64

        seconds + nanoSeconds
    }

    AsMillisf64(@this): f64 {
        sec := this.sec as f64
        nano := this.nano as f64
        seconds := sec * MILLI_PER_SEC as f64
        nanoSeconds := nano / NANO_PER_MILLI as f64 / 10 as f64

        seconds + nanoSeconds
    }

    AsSeconds(@this): u64 {
        millis := this.AsMillis()
        millis / MILLI_PER_SEC
    }

    AsSecondsf64(@this): f64 {
        millis := this.AsMillis()
        double := millis as f64
        double / 1000.0
    }

    Println(@this) {
        Println_duration(this)
    }

    Sub(this, other: Duration): Duration {

        selfSec := this.sec as u64
        otherSec := other.sec as u64
        
        selfNano := this.nano as u64
        otherNano := other.nano as u64

        mut seconds = selfSec - otherSec

        nonOverflow := this.nano >= other.nano
        if nonOverflow == false {
            nanoSeconds := selfNano - otherNano
            return Duration{sec: seconds as u64, nano: nanoSeconds as u32}
        }


        if seconds != 0 {
            seconds -= 1
        }
        nano_per_sec := NANO_PER_SEC as u64
        nano := selfNano + nano_per_sec - otherNano
        Duration{sec: seconds as u64, nano: nano as u32}
    }
}

Println_duration(self: @Duration) {
    sec := self.sec as uint
    nano := self.nano as uint
    Io.Print("Duration { sec: ")
    Io.Print_uint(sec)
    Io.Print(", nano: ")
    Io.Print_uint(nano)
    Io.Println(" }")
}