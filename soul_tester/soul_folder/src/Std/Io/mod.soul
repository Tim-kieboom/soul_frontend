import (
    .Fmt
    .Fmt.Formatter.{IoFormatter}
    .stdout.{Stdout}
)

Panic(
    msg: [@]char, 
    line: int = intrinsic.InLine(), 
    file: [@]char = intrinsic.InFile(),  
) {
    PrintPanicMsg(msg, line, file)
    intrinsic.Exit(1)
}

Assert(
    condition: bool, 
    msg: [@]char = "", 
    line: int = intrinsic.InLine(), 
    file: [@]char = intrinsic.InFile(),
) {

    if condition == false {
        Print("!!ASSERT FAILED!! ")
        Panic(msg, line: line, file: file)
    }
}

PrintAssert(
    condition: bool, 
    msg: [@]char = "", 
    line: int = intrinsic.InLine(), 
    file: [@]char = intrinsic.InFile(),
) {

    if condition == false {
        Print("!!ASSERT FAILED!! ")
        PrintPanicMsg(msg, line, file)
    }
}

PrintPanicMsg(msg: [@]char, line: int, file: [@]char) {
    Print("|PANIC at ")
    Print(file)
    Print_char(':')
    Print_int(line)
    Print_char(':')
    Print_int(0)
    Print("| ")
    Println(msg)
}

Println_bool(value: bool) {
    Print_bool(value)
    Endln()
}

Println_int(value: int, base: u8 = 10, capital: bool = true) {
    Print_int(value, base: base, capital: capital)
    Endln()
}

Println_uint(value: uint, base: u8 = 10, capital: bool = true) {
    Print_uint(value, base: base, capital: capital)
    Endln()
}

Println_float(value: f64, base: u8 = 10, capital: bool = true, precision: u8 = 4) {
    Print_float(value, base: base, capital: capital, precision: precision)
    Endln()
}

Print_bool(value: bool) {
    
    if value == true {
        Stdout.WriteCstr(c"true")
    } else {
        Stdout.WriteCstr(c"false")
    }
}

Print_int(value: int, base: u8 = 10, capital: bool = true) {
    mut fmt = IoFormatter{}
    Fmt.I64(value as i64, &fmt)
}

Print_uint(value: uint, base: u8 = 10, capital: bool = true) {
    mut fmt = IoFormatter{}
    Fmt.U64(value as u64, &fmt)
}

Print_float(value: f64, base: u8 = 10, precision: u8 = 4, capital: bool = true) {
    mut fmt = IoFormatter{}
    Fmt.F64(value, &fmt)
}

Print_char(char: char) {
    Stdout.WriteChar(char)
}

Println_Cstr(cstr: c_str) {
    Stdout.WriteCstr(cstr)
    Endln()
}

Print_Cstr(cstr: c_str) {
    Stdout.WriteCstr(cstr)
}

Println(text: [@]char) {
    Print(text)
    Endln()
}

Print(text: [@]char) {
    Stdout.WriteStr(text)
}

Endln() {
    Print_char('\n')
}

Println_char(letter: char) {
    Print_char(letter)
    Endln()
}
