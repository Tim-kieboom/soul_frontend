import (
    ./.stdout.{Stdout}
)

struct IoFormatter {}
use IoFormatter {
    New(): IoFormatter {
        IoFormatter{}
    }

    Push(&this, ch: char) {
        Stdout.WriteChar(ch)
    }

    PushStr(&this, string: [@]char) {
        Stdout.WriteStr(string)
    }

    PushCstr(&this, string: c_str) {
        Stdout.WriteCstr(string)
    }
}