import (
    ./.stdout.{Stdout}
    .Formatter.{IoFormatter}
)

extern "C" __clib_fmtI64(value: i64, buffer: &[32]char): c_int
extern "C" __clib_fmtU64(value: u64, buffer: &[25]char): c_int
extern "C" __clib_fmtF64(value: f64, buffer: &[64]char): c_int

I64(n: i64, fmt: &IoFormatter) {
    mut buffer: [32]char
    __clib_fmtI64(n, &buffer)
    fmt.PushCstr(buffer as c_str)
}

U64(n: u64, fmt: &IoFormatter) {
    mut buffer: [25]char
    __clib_fmtU64(n, &buffer)
    fmt.PushCstr(buffer as c_str)
}

F64(n: f64, fmt: &IoFormatter) {
    mut buffer: [64]char
    __clib_fmtF64(n, &buffer)
    fmt.PushCstr(buffer as c_str)
}