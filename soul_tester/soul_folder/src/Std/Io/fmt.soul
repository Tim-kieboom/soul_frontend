extern "C" __clib_fmtInt(value: c_int, base: u8, buffer: *char, capital: bool): c_str
extern "C" __clib_fmtUint(value: c_uint, base: u8, buffer: *char, capital: bool): c_str
extern "C" __clib_fmtFloat(value: f64, base: u8, buffer: *char, precision: u8, capital: bool): c_str

FmtInt(n: int, base: u8, buffer: @[25]char, capital: bool): c_str {
    literal NUMBERS = c"0123456789ABCDEF" as *char

    len := buffer.len
    lastIndex := len - 1
    mut ptr = buffer as *char
    ptr = intrinsic.PtrOffset(ptr, 24)
    *ptr = '\0'

    mut num = n as i64
    sign := if num >= 0 {
        false
    } else {
        num = num * -1
        true
    }

    basei64 := base as i64
    while {

        ptr = intrinsic.PtrOffset(ptr, -1)
        i := num % basei64
        ref := intrinsic.PtrOffset(NUMBERS, i as int)
        ch := *ref
        *ptr = ch

        num /= basei64
        if num <= 0 {
            break;
        }
    }
    
    if sign {
        ptr = intrinsic.PtrOffset(ptr, -1)
        *ptr = '-'
    }

    ptr as c_str
}

/*
