    const str NUMBERS = "0123456789ABCDEF";
    const str NUMBERS_LOWER = "0123456789abcdef";

    str ptr = &buf[49];
    *ptr = '\0';

    if (base < 2 || base > 16)
        return NULL;
    
    int sign = 0;
    if (num < 0) {
        sign = 1;
        num = -num;
    }

    const str numbers = capital ? NUMBERS : NUMBERS_LOWER;
    do {
        *--ptr = numbers[num % base];
        num /= base;
    } while (num);

    if (sign) *--ptr = '-';
    return ptr;
}
*/

FmtUint(n: uint, base: u8, buffer: @[25]char, capital: bool): c_str {
    __clib_fmtUint(n as c_uint, base, buffer as *char, capital)
}

FmtFloat(n: f64, base: u8, buffer: @[25]char, precision: u8, capital: bool): c_str {
    __clib_fmtFloat(n, base, buffer as *char, precision, capital)
}

