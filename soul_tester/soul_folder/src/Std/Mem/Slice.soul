import (
    ./.Io
)

IndexCopy<T>(self: [@]T, index: uint): T {
    len := self.len
    inBounds := len > index
    if inBounds == false {

        Io.PrintAssert(false)
        Io.Print("Index is out of range len: ")
        Io.Print_uint(len)
        Io.Print(", index: ")
        Io.Print_uint(index)
        intrinsic.Exit(1)
    }

    ref := intrinsic.PtrOffset(self as *T, index as int)
    *ref
}

Index<T>(self: [@]T, index: uint): @T {
    len := self.len
    inBounds := len > index
    if inBounds == false {

        Io.PrintAssert(false)
        Io.Print("Index is out of range len: ")
        Io.Print_uint(len)
        Io.Print(", index: ")
        Io.Print_uint(index)
        intrinsic.Exit(1)
    }

    ref := @*intrinsic.PtrOffset(self as *T, index as int)
    ref
}

IndexMut<T>(self: [&]T, index: uint): &T {
    len := self.len
    inBounds := len > index
    if inBounds == false {
        
        Io.PrintAssert(false)
        Io.Print("IndexMut is out of range len: ")
        Io.Print_uint(len)
        Io.Print(", index: ")
        Io.Print_uint(index)
        intrinsic.Exit(1)
    }
    
    ref := &*intrinsic.PtrOffset(self as *T, index as int)
    ref
}
