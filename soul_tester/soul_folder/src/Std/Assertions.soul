import (
    .Io.{PrintPanicMsg, Print}
)

Panic(
    msg: [@]char, 
    line: int = intrinsic.InLine(), 
    file: [@]char = intrinsic.InFile(),  
) {
    PrintPanicMsg(msg, line, file)
    intrinsic.Exit(1)
}

Assert(
    condition: bool, 
    msg: [@]char = "", 
    line: int = intrinsic.InLine(), 
    file: [@]char = intrinsic.InFile(),
) {

    if condition == false {
        Print("!!ASSERT FAILED!! ")
        Panic(msg, line: line, file: file)
    }
}