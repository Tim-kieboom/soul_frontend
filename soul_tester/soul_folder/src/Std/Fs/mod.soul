import (
    ./.Io
    ./.Assertions.{Panic}
    ./.Mem.Str.{StringBuilder}
)

extern "C" fclose(file: *none)
extern "C" fgetc(file: *none): c_int
extern "C" fopen(path: c_str, mode: c_str): *none
extern "C" __clib_fopen_error(exitCode: c_int): c_str
extern "C" fseek(file: *none, offset: i64, origin: c_int): c_int
extern "C" fopen_s(file: &*none, path: c_str, mode: c_str): c_int

literal EOF = -1
literal SEEK_SET: c_int = 0

struct File {
    cFilePtr: *none
}

FileModeCstr(value: u8): c_str {
    if value == 1 {
        c"r+"
    } else if value == 2 {
        c"w"
    } else {
        c"r"
    }
}

File Open(path: c_str, mode: u8): File {
    mode_str := FileModeCstr(mode as u8)
    
    mut cFilePtr: *none = null
    exitCode := fopen_s(&cFilePtr, path, mode_str)
    if cFilePtr == null {
        Io.Print("file failed to open error: ")
        err := __clib_fopen_error(exitCode)
        Io.Print_Cstr(err)
        Panic("")
    }

    File{cFilePtr}
}

File Read(@this): [*]char {

    file := this.cFilePtr

    mut sb = StringBuilder.New()
    mut ch: c_int = fgetc(file)
    while ch != -1 {
        sb.Push(ch as char)
        ch = fgetc(file)
    }

    exitCode := fseek(file, 0, SEEK_SET)
    sb.IntoStr() 
}

File Close(this) {
    ptr := this.cFilePtr
    if ptr != null {
        fclose(ptr)
    }
}
