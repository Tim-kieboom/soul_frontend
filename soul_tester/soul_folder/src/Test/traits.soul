import (
    ./.Std.Io
)

RunTests() {
    test_basic_trait()
    test_index_trait()
    test_trait_generic()
}

test_basic_trait() {
    obj := MyStruct{ value: 42 }
    result := obj.GetValue()
    Io.PrintAssert(result == 42, msg: "trait method GetValue should return 42")
}

test_index_trait() {
    array := [1, 2]
    mut ints = Ints2d{array}
    ref := @ints[0]
    Io.PrintAssert(*ref == 1)

    val := *ref
    Io.PrintAssert(val == 1)

    mutRef := &ints[1]
    Io.PrintAssert(*mutRef == 2)

    ints[1] = 7
    Io.PrintAssert(ints[1] == 7)
    Io.PrintAssert(true)
}

test_trait_generic() {
    a := Pair{ first: 10, second: 20 }
    sum := a.Sum()
    Io.PrintAssert(sum == 30, msg: "generic trait Sum should return 30")
}

struct Ints2d {
    mut array: [2]int
}
use Ints2d {
    impl IndexRef<int> {
        IndexRef(@this, index: uint): @int {
            Io.Assert(index <= 2, msg: "index out of bounds")
            @*intrinsic.PtrOffset(this.array as *int, index)
        }
    }
    impl IndexMut<int> {
        IndexMut(&this, index: uint): &int {
            Io.Assert(index <= 2, msg: "index out of bounds")
            &*intrinsic.PtrOffset(this.array as *int, index)
        }
    }
}

trait HasValue {
    GetValue(@this): int
}

struct MyStruct {
    value: int
}

use MyStruct impl HasValue {
    GetValue(@this): int {
        this.value
    }
}

trait Addable {
    Sum(@this): int
}

struct Pair {
    first: int
    second: int
}

use Pair impl Addable {
    Sum(@this): int {
        this.first + this.second
    }
}
