import (
    ./.Std.Io
)

RunTests() {
    test_block_statement()
    test_slice_return_type()
    test_return_deref()
    test_if_bare_condition()
    test_if_else_return()
    test_inner_function()
    test_inner_with_same_name_from_different_outer()
}

test_block_statement() {
    mut value = 0
    {
        value = 42
    }
    Io.Assert(value == 42, msg: "Bug 4: block statement should set value to 42")
}

test_slice_return_type() {
    greeting(): [@]char {
        "hello"
    }

    s := greeting()
    Io.Assert(true)
}

test_return_deref() {
    deref_val(p: &int): int {
        return *p
    }

    mut x = 99
    result := deref_val(&x)
    Io.Assert(result == 99, msg: "Bug 7: return *ptr should be 99")
}

test_if_bare_condition() {
    condition: bool = true

    mut result = 0
    if condition {
        result = 1
    }
    Io.Assert(result == 1, msg: "Bug 8: if bare condition should set result to 1")
}

test_if_else_return() {
    pick(n: int): int {
        if n > 0 {
            return 1
        } else {
            return 2
        }
    }

    Io.Assert(pick(1) == 1, msg: "Bug 9: if-else return should be 1")
    Io.Assert(pick(-1) == 2, msg: "Bug 9: if-else return should be 2")
}


test_inner_function() {
    inner(): int { 42 }

    result := inner()
    Io.Assert(result == 42, msg: "Bug 10: inner function should return 42")
}

outer_with_helper_a(): int {
    helper(): int { 100 }

    helper()
}

outer_with_helper_b(): int {
    helper(): int { 200 }

    helper()
}

test_inner_with_same_name_from_different_outer() {
    result_a := outer_with_helper_a()
    result_b := outer_with_helper_b()
    Io.Assert(result_a == 100, msg: "Bug 10: outer_with_helper_a should return 100")
    Io.Assert(result_b == 200, msg: "Bug 10: outer_with_helper_b should return 200")
}
