import (
    ./.Std.Io
)

struct Object {
    field: i64
    condition: bool
}

union Test (
    Int(i32),
    Float(f32),
    Object(Object),
)

RunTests() {
    test_init_union()
}

test_init_union() {
    interger: Test = Test.Int(42)
    float := Test.Float(3.14)
    object := Test.Object(Object{field: 1, condition: true})

    Io.Assert(interger typeof Test.Int, msg: "interger should be of type Test.Int")
    Io.Assert(float typeof Test.Float, msg: "float should be of type Test.Float")
    Io.Assert(object typeof Test.Object, msg: "object should be of type Test.Object")
    
    Io.Assert(intrinsic.UnionTag(interger) == 0, msg: "interger tag should be 0 (Int)")
    Io.Assert(intrinsic.UnionTag(float) == 1, msg: "float tag should be 1 (Float)")
    Io.Assert(intrinsic.UnionTag(object) == 2, msg: "object tag should be 2 (Object)")

    if interger typeof Test.Int(num) {
        Io.Assert(num == 42)
    }

    match float {
        Test.Float(num) => Io.Assert(num == 3.14)
        _ => Io.Panic("should be Test.Float")
    }

    match object {
        Test.Int(_) => Io.Panic("should be Test.Object")
        Test.Float(_) => Io.Panic("should be Test.Object")
        Test.Object(obj) => {
            Io.Assert(obj.field == 1)
            Io.Assert(obj.condition == true)
        }
    }
}

union MyResult (
    Ok(int),
    Err([@]char),
)

test_union_match_methodes() { 
    literal OK_VALUE = 1
    ok := MyResult.Ok(OK_VALUE)
    err := MyResult.Err("error")

    mut number: int = ok.Err{-1}
    Io.Assert(number == OK_VALUE)

    number = err.Ok{return}
    Io.Assert(number == OK_VALUE)

    ok
        .Ok{val => Io.Assert(val == 1)}
        .Err{val => Io.Assert(val == "error")}
}
