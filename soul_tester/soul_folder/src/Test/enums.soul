import (
    ./.Std.Io
)

RunTests() {
    test_should_have_correct_tag()
    test_should_cmp_correctly()
}

test_should_have_correct_tag() {
    Io.PrintAssert(Basic.Zero  as u32 == 0, msg: "Basic.Zero should be 0")
    Io.PrintAssert(Basic.One   as u32 == 1, msg: "Basic.One should be 1")
    Io.PrintAssert(Basic.Two   as u32 == 2, msg: "Basic.Two should be 2")
    Io.PrintAssert(Basic.Three as u32 == 3, msg: "Basic.Three should be 3")
}

test_should_cmp_correctly() {
    Io.PrintAssert(Basic.One <= Basic.One, msg: "Basic.One should leq Basic.One")
    Io.PrintAssert(Basic.One >= Basic.One, msg: "Basic.One should geq Basic.One")
    Io.PrintAssert(Basic.One == Basic.One, msg: "Basic.One should be Basic.One")
    Io.PrintAssert(Basic.One != Basic.Two, msg: "Basic.One should not be Basic.Two")
    Io.PrintAssert(Basic.One < Basic.Two,  msg: "Basic.One should be smaller then Basic.Two")
    Io.PrintAssert(Basic.Two > Basic.One,  msg: "Basic.Two should be bigger then Basic.One")
}

enum Basic {
    Zero,
    One,
    Two,
    Three,
}