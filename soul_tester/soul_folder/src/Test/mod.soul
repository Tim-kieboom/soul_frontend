import (
    .ifs
    .enums
    .matches
    ./.Std.Io
    ./.Std.Time.{Instance, Duration}
)

RunTests() {

    total := Instance.Now()

    ifs.RunTests()
    enums.RunTests()
    matches.RunTests()
    logTime(total.Elapsed())
}

logTime(time: Duration) {
    ms := time.AsMillisf64()
    Io.Print("Test Time ms: ")
    Io.Println_float(ms)
}