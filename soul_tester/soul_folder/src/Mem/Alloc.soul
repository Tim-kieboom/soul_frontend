extern "C" free(ptr: *none)
extern "C" malloc(size: uint): *u8
extern "C" realloc(ptr: *none, size: uint): *none

RawAlloc(size: uint): *u8 {
    malloc(size)
}

Alloc<T>(): *T {
    literal SIZE = T.sizeof as uint
    ptr := malloc(SIZE) 
    ptr as *T
}

AllocMultiple<T>(size: uint): *T {
    literal SIZE = T.sizeof as uint
    ptr := malloc(SIZE * size) as *T
    ptr as *T
}

ReallocMultiple<T>(array: *T, newSize: uint): *T {
    literal SIZE = T.sizeof as uint
    ptr := realloc(array as *none, SIZE * newSize) as *T
    ptr as *T
}

Dealloc<T>(ptr: *T) {
    free(ptr as *none)
}

