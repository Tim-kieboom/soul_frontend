extern "C" __clib_printChar(ch: char)
extern "C" __clib_printCStr(ptr: c_str)
extern "C" __clib_printSoulStr(ptr: *char, len: uint)

struct Stdout {}

Stdout WriteChar(ch: char) {
    __clib_printChar(ch)
}

Stdout WriteCstr(cstr: c_str) {
    __clib_printCStr(cstr)
}

Stdout WriteStr(text: [@]char) {
    __clib_printSoulStr(text as *char, text.len)
}