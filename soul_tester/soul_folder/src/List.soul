import (
    .Mem.Ptr.{Offset}
    .Mem.Alloc.{AllocMultiple, ReallocMultiple}
)

struct List {
    mut array: *u8
    mut len: uint
    mut cap: uint
}
use List {
    New(size: uint = 0): List {
        array := AllocMultiple<u8>(size)
        List{array, len: 0, cap: size}
    }

    Push(&this, value: u8) {
        
        len := this.len
        c := len+1 > this.cap
        if c == true {
            if len == 0 {
                this.resize(1)
            } else {
                this.resize(len*2)
            }
        }

        array := this.array
        ptr := Offset<u8>(array, len as int)
        *ptr = value
        this.len += 1
    }

    Index(@this, index: uint): u8 {
        array := this.array
        ptr := Offset<u8>(array, index as int)
        num := *ptr
        num
    }

    Drop(this) {
        ptr := this.array
        if ptr as int != 0 {
            free(ptr as *none)
        }
    }

    resize(&this, newSize: uint) {
        this.cap = newSize
        this.array = ReallocMultiple<u8>(this.array, newSize)
    }
}
