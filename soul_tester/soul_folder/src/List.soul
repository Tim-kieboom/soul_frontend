import (
    .Mem.Ptr
    .Mem.Alloc.{AllocArray, ReallocArray}
)

struct List {
    mut array: *u8
    mut len: uint
    mut cap: uint
}
List New(size: uint = 0): List {
    array := AllocArray<u8>(size)
    List{array, len: 0, cap: size}
}

List Push(&this, value: u8) {
    
    len := this.len
    c := len+1 > this.cap
    if c == true {
        if len == 0 {
            this.resize(1)
        } else {
            this.resize(len*2)
        }
    }

    array := this.array
    ptr := Ptr.Offset(array, len as int)
    *ptr = value
    this.len += 1
}

List Index(@this, index: uint): u8 {
    array := this.array
    ptr := Ptr.Offset(array, index as int)
    num := *ptr
    num
}

List Drop(this) {
    ptr := this.array
    if ptr as int != 0 {
        free(ptr as *none)
    }
}

List resize(&this, newSize: uint) {
    this.cap = newSize
    this.array = ReallocArray<u8>(this.array, newSize)
}

