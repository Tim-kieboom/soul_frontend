import (
    .Mem.Alloc.{AllocMultiple, ReallocMultiple}
)


struct List {
    mut array: *u8
    mut len: uint
    mut cap: uint
}
use List {
    New(size: uint = 0): List {
        array := AllocMultiple<u8>(size)
        List{array, len: 0, cap: size}
    }

    Push(&this, value: u8) {
        
        len := this.len
        c := len+1 > this.cap
        if c == true {
            newSize := if len == 0 {1} else {len*2}
            this.resize(newSize)
        }

        array := this.array
        ptr := intrinsic.PtrOffset(array, len as int)
        *ptr = value
        this.len += 1
    }

    Index(@this, index: uint, success: &bool): *u8 {
        if index > this.len {
            return null
        }

        intrinsic.PtrOffset(this.array, index as int)
    }

    Drop(this) {
        ptr := this.array
        if ptr as int != 0 {
            free(ptr as *none)
        }
    }

    resize(&this, newSize: uint) {
        this.cap = newSize
        this.array = ReallocMultiple<u8>(this.array, newSize)
    }
}
