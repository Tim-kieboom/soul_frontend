import ( 
    crate.Io
    crate.Test
    crate.Mem.Slice.{Index}
)

main() {
    ptr := new(1)
    Io.Println_int(*ptr)

    mut array = new:[1, 2, 3, 4]
    mut ref = Index<int>(@array, 1)
    Io.Print("array.len = ")
    Io.Print_uint(array.len)
    Io.Print(", array[1] = ")
    Io.Println_int(*ref)

    array = new:[for 10 => 3]
    ref = Index<int>(@array, 1)
    Io.Print("array.len = ")
    Io.Print_uint(array.len)
    Io.Print(", array[1] = ")
    Io.Println_int(*ref)
}