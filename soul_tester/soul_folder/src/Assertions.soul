import (
    .Io.{PrintPanicMsg}
)

Panic(
    msg: [@]char, 
    line: int = intrinsic.InLine(), 
    file: [@]char = intrinsic.InFile(),  
) {
    PrintPanicMsg(msg, line, file)
    intrinsic.Exit(1)
}

Assert(
    condition: bool, 
    msg: [@]char = "", 
    line: int = intrinsic.InLine(), 
    file: [@]char = intrinsic.InFile(),
) {

    if condition == false {
        PrintPanicMsg(msg, line, file)
        intrinsic.Exit(1)
    }
}