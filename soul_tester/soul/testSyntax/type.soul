type Type = intrinsic.Type

pub toString(object: &any): str {
    mut sb = StringBuilder.()
    innerToString(object, sb)
    sb.toStr()
}

innerToString(object: &any, sb: &mut impl Writer) {

    match &object.type {
        Type.Primitive(primitive) => match primitive.kind {
            Int(value) => sb.writeInt(value)
            Char(value) => sb.write(value)
            Bool(value) => sb.writeBool(value)
            Uint(value) => sb.writeUint(value)
            Float(value) => sb.writeFloat(value)
        }
        Type.Nullable(nullable) => match &nullable.value {
            null => sb.writeStr("null")
            value => innerToString(value, sb)
        }
        Type.DistinctType(ty) => {
            sb.writeStr(ty.name)
            sb.writeStr(".(")
            innerToString(ty.value, sb)
            sb.write(')')
        }
        Type.Pointer(pointer) => innerToString(&*pointer.value, sb)
        Type.Struct(struct_) => {
            sb.writeFmt(fstr"{struct_.name}{{")
            lastIndex := struct_.fields.len()-1
            for i, field in &struct_.fields {
                sb.writeFmt(fstr"{field.name}: ")
                innerToString(&field.value, sb)
                if i != lastIndex {
                    sb.writeStr(", ")
                }
            }
        }
        Type.Tuple(tuple) => {
            sb.push('(')
            lastIndex := tuple.values.len()-1
            for i, value in &tuple.values {

                innerToString(value, sb)
                if i != lastIndex {
                    self.pushStr(", ")
                }
            }
            sb.push(')')
        }
        Type.NamedTuple(tuple) => {
            sb.push('(')
            lastIndex := tuple.values.len()-1
            for i, (name, value) in &tuple.values {

                sb.pushFmt(fstr"{name}: ")
                innerToString(value, sb)
                if i != lastIndex {
                    self.pushStr(", ")
                }
            }
            sb.push(')')
        }
        Type.Fstr(fstring) => sb.writeFmt(fstring)
        Type.Array(array) => {
            values := match array.kind {
                Type.ArrayKind.RefArray(arr) => arr.values.iter()
                Type.ArrayKind.MutArray(arr) => arr.values.iter()
                Type.ArrayKind.HeapArray(arr) => arr.values.iter()
                Type.ArrayKind.StackArray(arr) => arr.values.iter()
            }

            sb.write('[')
            lastIndex := values.len()-1
            for i, value in values {

                innerToString(value, sb)
                if i != lastIndex {
                    sb.pushStr(", ")
                }
            }
            sb.write(']')
        }
        Type.Enum(enum_) => {
            match enum_.variantKind {
                Type.EnumKind.Union(variant) => {
                    sb.pushFmt(fstr"{enum_.name}.{variant.name}")
                    innerToString(&variant.value, sb)
                }
                Type.EnumKind.CEnum(varaint) => sb.pushFmt(fstr"{enum_.name}.{variant.name}")
            }
        }
        Type.Str(string) => sb.pushStr(string)
        Type.None => sb.pushStr("()")
    }
}