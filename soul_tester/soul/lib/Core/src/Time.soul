literal MILLIS_PER_SEC: u64 = 10 ** 3
literal NANOS_PER_MICRO: u32 = 10 ** 3
literal MICROS_PER_SEC: u64 = 10 ** 6
literal NANOS_PER_MILLI: u32 = 10 ** 6
literal NANOS_PER_SEC: u32 = 10 ** 9

pub struct Duration {
    mut seconds: u64 = 0
    mut nanos: u32 = 0

    pub This.(seconds: u64 = 0, nanos: u32 = 0) {
        This{seconds, nanos}
    }

    pub fromSeconds(seconds: u64) {
        This{seconds, nanos: 0}
    }
}