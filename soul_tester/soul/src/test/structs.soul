pub struct Map {
    pub type Key = str
    pub type Value = int

    pub struct KeyValue {
        
        pub mut key: Key
        pub mut value: Value

        pub This.(key: Key, value: Value) {
            This{key, value}
        }
    }

    list := List.[KeyValue: ]
    pub mut field = 1

    pub This.(field: int) {
        This{field, ..}
    }

    pub This.[KeyValue](array) {
        
        This{list: array.into(), ..}
    }

    sum(this, b: int): int {
        this.field + b
    }
}

use Map at(&this, i: uint): int {
    this.list[i]
}