pub struct Map {

    pub struct KeyValue {
        pub mut key: Key
        pub mut value: Value
    }

    list := List.[int: ]
    pub mut field = 1

    pub This.() {
        This{..}
    }

    pub This.[int](list) {
        This{list, ..}
    }

    sum(this, b: int): int {
        this.field + b
    }
}

use Map at(&this, i: uint): int {
    this.list[i]
}

