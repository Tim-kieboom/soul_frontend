pub sum(a: int, b: int): int {
    a + b
}

pub trait Index {
    type Out
    index(&this, index: I): &Out
}

pub trait IndexMut: Index {
    indexMut(&mut this, index: I): &mut This.Out
}

pub struct Map {

    pub struct KeyValue {
        pub mut key: Key
        pub mut value: Value
    }

    list := List.[int: ]
    pub mut field = 1

    pub This.() {
        This{..}
    }

    pub This.[int](array) {
        
        This{list: array.into(), ..}
    }

    sum(this, b: int): int {
        this.field + b
    }
}

use Map at(&this, i: uint): int {
    this.list[i]
}

