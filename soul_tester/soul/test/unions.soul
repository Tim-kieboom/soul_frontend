unions() {
    enum Union {
        None,
        Uint(int),
        Fmt(fstr),
        String(str),
        Int{field: int, foo: bool},
    }

    obj := Union.None
    string := obj
        .Int{"int"}
        .Fmt{"fmt"}
        .None{"none"}
        .Uint{"uint"}
        .String{"string"}

    num := obj
        .Uint{it}
        .else{return}
}