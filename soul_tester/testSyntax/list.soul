class List<T> {
    literal INCREASE_FACTOR = 2.0
    mut buffer: [*]?T = new:[]
    mut len = 0

    This(capacity: uint = 0): Res<This> {
        this.Reserve(capacity)
    }

    This:[T](array): Res<This> {
        this.ExtendArray(array)      
    }

    Len(@this): uint {
        this.len
    }

    Cap(@this): uint {
        this.buffer.Len()
    }

    ExtendArray(&this, array: [_]T): Res {
        this.ReserveAtLeast(array.Len()).pass
        for value in array {
            this.Push(value)
        }
        Ok()
    }

    Push(&this, value: T) {
        this.TryPush(value).Err{panic}
    }

    TryPush(&this, value: T): Res {
        if len+1 > Cap() {
            this.grow().pass
        }

        this.buffer[this.len].pass = value
        this.len += 1
        Ok()
    }

    Pop(&this): ?T {
        TryPop().Err{panic}
    }

    TryPop(&this): Res<?T> {
        if this.len == 0 {
            return Ok(null)
        }

        mut temp = null
        this.len -= 1
        Swap(&this.buffer[this.len].pass, &temp)

        temp.ToRes(Err("Pop element is somehow Uninit"))
    }

    Reserve(&this, toCapacity: uint): Res {
        import Std.Mem.{Swap}

        old := this.buffer
        buffer = new:[for toCapacity => null].pass

        minLen := this.len.Min(toCapacity)
        for i in 0..minLen {
            Swap(&this.buffer[i].pass, &old[i].pass)
        }

        Ok()
    }

    Resize(&this, toCapacity: uint, default: T): Res {
        import Std.Mem.{Swap}

        old := this.buffer
        buffer = new:[for toCapacity => default.copy].pass
 
        minLen := this.len.Min(toCapacity)
        for i in 0..minLen {
            Swap(&this.buffer[i].pass, &old[i].pass)
        }

        Ok()
    }

    ReserveAtLeast(len: uint): Res {
        mut capReserve := f64(this.Cap().Min(1))
        capNeeded := f64(len + this.Len())
        while capReserve < capNeeded {
            capReserve = capReserve * this.INCREASE_FACTOR
        }

        Reserve(uint(capReserve))
    }

    grow(): Res {
        oldCap := f64(this.Cap().Min(1))
        cap := uint(oldCap * this.INCREASE_FACTOR)
        Reserve(cap)
    }

    impl Index {
        type Item = T

        Index(@this, index: uint): Res<@This.Item> {
            
            if index < this.len {
                return Err(OutOfBounds(this.len, index))
            }

            this.buffer.Index(index)
        }
    }

    impl IndexMut {

        IndexMut(&this, index: uint): Res<&This.Item> {
            
            if index < len {
                return Err(OutOfBounds(len, index))
            }

            buffer.IndexMut(index)
        }
    }
}