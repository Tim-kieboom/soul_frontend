literal CHARS = type:[
    char,
    char8,
    char16,
    char32,
    char64,
]

literal FLOATS = type:[
    untypedFloat,
    f16,
    f32, 
    f64,
]

literal INTS = type:[
    untypedInt, 
    c_int,
    int,
    i8, 
    i16, 
    i32, 
    i64, 
    i128,
]

literal UINTS = type:[
    untypedUint,
    c_uint,
    uint, 
    u8, 
    u16, 
    u32, 
    u64, 
    u128,
]

literal NUMBERS = type:[
    FLOATS,
    INTS,
    UINTS,
].Flatten()

literal PRIMITIVE_TYPES = type:[
    type:[bool],
    CHARS,
    NUMBERS,
].Flatten()

trait PrimitiveType {}

syntax.implEmptyTrait(
    PRIMITIVE_TYPES,
    PrimitiveType
)
syntax.implPrims(PRIMITIVE_TYPES)

use syntax {

    literal implEmptyTrait(this, TS: [_]type, TRAIT: type.trait) {
        
        for T in TS {
            
            this.AddSyntax(syntax{
                use $T impl $TRAIT {} 
            })
        }
    }

    literal implPrims(this, TS: [_]type) {   
        
        for T in TS {
            
            match T {
                type.Interger(T_INT) => syntax.implInterger(T_INT)
                type.bool(_) => syntax.implBool()
                _ => panic("todo")
            }
        }
    }


    literal implBool(this) {

        this.AddSyntax(syntax{
            use bool {
                literal MAX = true
                literal MIN = false

                This(num: impl PrimitiveType) {
                    num as This
                }

                impl Sized {
                    ByteSize(): uint {bool.typeof}
                }
            }
        })
    }

    literal implInterger(this, T: type.Interger) {
        literal INTERGER = T.toInterger()
            .Err{literalPanic}

        literal BYTES = T.sizeof as T
        literal BITS = BYTES * 8
        literal IS_SIGNED = INTERGER.isSigned()
        literal MAX = if IS_SIGNED {(BITS/2) ** 2 - 1} else {BITS ** 2 - 1} 
        literal MIN = if IS_SIGNED {(BITS/2) ** 2 * -1} else {0}

        this.AddSyntax(syntax{
            use $T {
                literal MIN: $T = $MIN
                literal MAX: $T = $MAX

                This(num: impl PrimitiveType) {
                    num as This
                }

                impl Sized {
                    ByteSize(): u32 {$T.sizeof}
                }
            }
        })
    }
}
