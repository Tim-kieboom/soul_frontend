literal $CHARS = type:[
    char,
    char8,
    char16,
    char32,
    char64,
]

literal $FLOATS = type:[
    untypedFloat,
    f16,
    f32, 
    f64,
]

literal $INTS = type:[
    untypedInt, 
    c_int,
    int,
    i8, 
    i16, 
    i32, 
    i64, 
    i128,
]

literal $UINTS = type:[
    untypedUint,
    c_uint,
    uint, 
    u8, 
    u16, 
    u32, 
    u64, 
    u128,
]

literal $NUMBERS = type:[
    $FLOATS,
    $INTS,
    $UINTS,
].Flatten()

literal $PRIMITIVE_TYPES = type:[
    type:[bool],
    $CHARS,
    $NUMBERS,
].Flatten()

trait PrimitiveType {}

literal $implEmptyTrait(TS: [_]type, TRAIT: type.trait): syntax {
    
    literal IMPLS = syntax{}
    for T in TS {
        
        IMPLS.Append(syntax{
            use $T impl $TRAIT {} 
        })
    }
    IMPLS
}

literal $implPrims(TS: [_]type): syntax {   
    
    literal IMPLS = syntax{}
    for T in TS {
        
        literal IMPL = T.Type() {
            type.Interger(TYPE) => $implInterger(T_INT)
            type.bool(_) => $implBool()
            _ => panic("todo")
        }

        IMPLS.Append(IMPL)
    }
    IMPLS
}


literal $implBool(): syntax {

    syntax{
        use bool {
            literal MAX = true
            literal MIN = false

            #[inline]
            This(num: impl PrimitiveType) {
                num as This
            }

            impl Sized {
                ByteSize(): uint {bool.typeof}
            }
        }
    }
}

literal $implInterger(T: type.Interger): syntax {
    literal INTERGER = T.toInterger()
        .Error{literalPanic}

    literal BYTES = T.sizeof as T
    literal BITS = BYTES * 8
    literal IS_SIGNED = INTERGER.isSigned()
    literal MAX = if IS_SIGNED {(BITS/2) ** 2 - 1} else {BITS ** 2 - 1} 
    literal MIN = if IS_SIGNED {(BITS/2) ** 2 * -1} else {0}
    syntax{
        use #T {
            literal MAX: #T = #MAX
            literal MIN: #T = #MIN

            #[inline]
            This(num: impl PrimitiveType) {
                num as This
            }

            impl Sized {
                ByteSize(): uint {#T.sizeof}
            }
        }
    }
}

$implEmptyTrait(
    $PRIMITIVE_TYPES,
    PrimitiveType
)
$implPrims($PRIMITIVE_TYPES)
