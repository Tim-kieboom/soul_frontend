import (
    Core.Fmt
)

struct ErrIndex {index: uint}
use ErrIndex {
    impl Error {}
    impl Fmt {
        Fmt(@this, fmt: &Fmt.Formatter): Fmt.Res {
            fmt.PushFmt(f"index: {this.index} is out of bounds")
        }
    }
}

use ResIndex<T> = Res<T, ErrIndex>
use<T, N as uint> [N]T {

    const Len(@this): uint {
        this.len
    }

    const AsPtr(@this): *T {
        (*this) as *T
    }

    const AsPtrMut(&this): *mut T {
        (*this) as *mut T
    }

    impl const Index {
        type Item = T

        const Index(@this, index: uint): ResIndex<@This.Item> {
            if index > N {
                return Err(ErrIndex{index})
            }

            ptr := this.ptr ?? panic("should not be null")
            Ok(
                @*intrinsic.PtrOffset(ptr, index as int)
            )
        }
    }

    impl const IndexMut<T> {
        const IndexMut(&this, index: uint): ResIndex<&This.Item> {
            if index > N {
                return Err(ErrIndex{index})
            }

            ptr := this.ptr ?? panic("should not be null")
            Ok(
                &*intrinsic.PtrOffset(ptr, index as int)
            )
        }
    }
}
