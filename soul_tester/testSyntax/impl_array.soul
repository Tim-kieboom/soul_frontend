
struct ErrIndex {index: uint}
use ErrIndex {
    impl Into<str> {..}
    impl Error {..}
    impl Fmt {..}
}

use ResIndex<T> = Res<T, ErrIndex>
use<T, N as uint> [N]T {

    const Len(@this): uint {
        this.len
    }

    impl const ConsumeIndex<T> {
        const ConsumeIndex(this, index: uint): ResIndex<T> {
            
            if index > N {
                return Err(ErrIndex{index})
            }

            ptr := this.ptr ?? panic("should not be null")
            Ok(
                *(ptr + index)
            )
        }
    }

    impl const RefIndex<T> {
        const RefIndex(@this, index: uint): ResIndex<@T> {
            if index > N {
                return Err(ErrIndex{index})
            }

            ptr := this.ptr ?? panic("should not be null")
            Ok(
                @*(ptr + index)
            )
        }
    }

    impl const MutIndex<T> {
        MutIndex(&this, index: uint): ResIndex<&T> {
            if index > N {
                return Err(ErrIndex{index})
            }

            ptr := this.ptr ?? panic("should not be null")
            Ok(
                &*(ptr + index)
            )
        }
    }
}
